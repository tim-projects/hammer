+def cleanup_path(path):
+    """Remove a test-owned path, failing loudly if cleanup fails."""
+    for attempt in range(5):
+        if not os.path.lexists(path):
+            return
+        try:
+            shutil.rmtree(path)
+            return
+        except OSError as error:
+            if error.errno != errno.ENOTEMPTY or attempt == 4:
+                raise
+            time.sleep(0.1)
+
