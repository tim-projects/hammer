+"""Concurrency hazards of the shared .tasks store.
+
+The store is one git repo written by every worktree and every agent session.
+Four defects let parallel agents corrupt it, each locked down here:
+
+1. Id allocation: two racing 'tasks create' calls must not allocate the same
+   id. The counter transaction takes a store-wide lock, so a concurrent writer
+   is excluded while it is held (asserted by holding the lock in the test).
+2. Manifest: two concurrent mounts must both survive in worktrees.json.
+3. Gate fast-track: a branch with zero commits beyond main must NOT bypass
+   pipeline gates; a branch that did work and was merged still does.
+4. Undo: commits are scoped by exact folder path, so sibling ids (1 vs 11)
+   are never confused, and no temp files are created inside the store.
+"""
+
+import fcntl
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+# tests/ itself carries stale 'tasks_ai' junk that shadows the real package
+# once pytest puts tests/ at the front of sys.path, so insert at 0 always.
+PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, PROJECT_ROOT)
+
+STORY = "Sufficiently long story content here to pass validation"
+TECH = "Sufficiently long technical description here to pass validation"
+PLAN = "Sufficiently long planning details here to pass validation"
+ACCEPT = "Sufficiently long acceptance criteria here to pass validation"
+BOXES = "- [ ] Sufficiently long acceptance criteria here to pass validation"
+
+
+class TestStoreConcurrency(unittest.TestCase):
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+        self.repo_dir = os.path.join(self.test_dir, "repo")
+        os.makedirs(self.repo_dir)
+        for args in (
+            ["init", "-b", "main"],
+            ["config", "user.email", "test@example.com"],
+            ["config", "user.name", "Test User"],
+        ):
+            subprocess.run(["git"] + args, cwd=self.repo_dir, capture_output=True)  # noqa: PLW1510
+        with open(os.path.join(self.repo_dir, "README.md"), "w") as handle:
+            handle.write("# Test Repo")
+        subprocess.run(
+            ["git", "add", "README.md"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            check=False,
+        )
+        subprocess.run(
+            ["git", "commit", "-m", "Initial commit"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            check=False,
+        )
+        self.script_path = os.path.join(PROJECT_ROOT, "hammer")
+        subprocess.run(
+            [self.script_path, "tasks", "init"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            check=False,
+        )
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    # --- helpers ---
+
+    @property
+    def store(self):
+        return os.path.join(self.repo_dir, ".tasks")
+
+    def run_cmd(self, args):
+        result = subprocess.run(  # noqa: PLW1510
+            [self.script_path, "tasks", "-j"] + args,
+            cwd=self.repo_dir,
+            capture_output=True,
+            text=True,
+        )
+        try:
+            payload = json.loads(result.stdout)
+        except json.JSONDecodeError:
+            return {
+                "success": False,
+                "stdout": result.stdout,
+                "stderr": result.stderr,
+                "returncode": result.returncode,
+            }
+        payload["returncode"] = result.returncode
+        return payload
+
+    def make_task(self, title, criteria=ACCEPT):
+        res = self.run_cmd(
+            [
+                "create",
+                title,
+                "--story",
+                STORY,
+                "--tech",
+                TECH,
+                "--criteria",
+                criteria,
+                "--plan",
+                PLAN,
+            ]
+        )
+        self.assertTrue(res["success"], res)
+        return res["data"]["id"], res["data"]["file"]
+
+    def make_processing_task(self, title, criteria=ACCEPT):
+        task_id, task_file = self.make_task(title, criteria)
+        for state in ("READY", "PROGRESSING"):
+            moved = self.run_cmd(["move", task_file, state])
+            self.assertTrue(moved["success"], moved)
+        return task_id, task_file
+
+    def seed_counter(self, value):
+        counter = os.path.join(self.store, ".task_counter")
+        if os.path.exists(counter):
+            os.remove(counter)
+        with open(counter, "w") as handle:
+            handle.write(str(value))
+        subprocess.run(
+            ["git", "add", ".task_counter"],
+            cwd=self.store,
+            capture_output=True,
+            check=False,
+        )
+        subprocess.run(
+            ["git", "commit", "-m", "seed counter"],
+            cwd=self.store,
+            capture_output=True,
+            check=False,
+        )
+
+    def snapshot_folder(self, task_file, state):
+        root = os.path.join(self.store, state, task_file)
+        snap = {}
+        for name in sorted(os.listdir(root)):
+            if os.path.isdir(os.path.join(root, name)):
+                continue
+            with open(os.path.join(root, name)) as handle:
+                snap[name] = handle.read()
+        return snap
+
+    def hold_lock(self):
+        """Take the store lock in this process; returns a release callable."""
+        fd = os.open(
+            os.path.join(self.store, ".hammer-lock"), os.O_CREAT | os.O_RDWR, 0o644
+        )
+        fcntl.flock(fd, fcntl.LOCK_EX)
+        released = []
+
+        def release():
+            if not released:
+                released.append(True)
+                fcntl.flock(fd, fcntl.LOCK_UN)
+                os.close(fd)
+
+        return release
+
+    def worktree_path(self, task_id):
+        with open(os.path.join(self.store, "worktrees.json")) as handle:
+            return json.load(handle)["worktrees"][str(task_id)]["path"]
+
+    # --- defect 1: id allocation ---
+
+    def test_held_lock_excludes_a_store_write(self):
+        """A store mutation must block while another agent holds the lock.
+
+        The deterministic half of the race test: the lock is held by the test
+        process itself, so a create that does not take the lock finishes
+        immediately and this test fails.
+        """
+        release = self.hold_lock()
+        self.addCleanup(release)
+        proc = subprocess.Popen(
+            [
+                self.script_path,
+                "tasks",
+                "-j",
+                "create",
+                "Alpha task while lock held",
+                "--story",
+                STORY,
+                "--tech",
+                TECH,
+                "--criteria",
+                ACCEPT,
+                "--plan",
+                PLAN,
+            ],
+            cwd=self.repo_dir,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        time.sleep(1.0)
+        self.assertIsNone(
+            proc.poll(), "a create must block while the store lock is held"
+        )
+        release()
+        try:
+            out, _ = proc.communicate(timeout=30)
+            payload = json.loads(out)
+        except (ValueError, subprocess.TimeoutExpired) as exc:  # pragma: no cover
+            self.fail(f"create did not complete after the lock was released: {exc}")
+        self.assertTrue(payload["success"], payload)
+
+    def test_concurrent_creates_get_distinct_ids(self):
+        """Two agents creating at the same time must not allocate one id twice."""
+        procs = [
+            subprocess.Popen(
+                [
+                    self.script_path,
+                    "tasks",
+                    "-j",
+                    "create",
+                    f"{name} task for id race",
+                    "--story",
+                    STORY,
+                    "--tech",
+                    TECH,
+                    "--criteria",
+                    ACCEPT,
+                    "--plan",
+                    PLAN,
+                ],
+                cwd=self.repo_dir,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+            )
+            for name in ("Alpha", "Beta")
+        ]
+        ids = []
+        for proc in procs:
+            out, _ = proc.communicate(timeout=60)
+            payload = json.loads(out)
+            self.assertTrue(payload["success"], payload)
+            ids.append(int(payload["data"]["id"]))
+        self.assertNotEqual(ids[0], ids[1], "racing creates must not share an id")
+        with open(os.path.join(self.store, ".task_counter")) as handle:
+            counter = int(handle.read().strip())
+        # Each create also allocates its paired test task's id, so the counter
+        # lands past the ids returned to the callers; it must not overshoot more
+        # than one companion per create.
+        self.assertGreaterEqual(counter, max(ids))
+        self.assertLessEqual(counter, max(ids) + len(ids))
+
+    def test_concurrent_mounts_keep_both_manifest_entries(self):
+        """Two mounts at once must both survive in worktrees.json."""
+        _, file_a = self.make_task("Alpha task for manifest race")
+        _, file_b = self.make_task("Beta task for manifest race")
+        ids = [file_a.split("-", 1)[0], file_b.split("-", 1)[0]]
+        procs = [
+            subprocess.Popen(
+                [self.script_path, "tasks", "-j", "mount", task_id],
+                cwd=self.repo_dir,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+            )
+            for task_id in ids
+        ]
+        for proc in procs:
+            out, _ = proc.communicate(timeout=60)
+            self.assertTrue(json.loads(out)["success"], out)
+        with open(os.path.join(self.store, "worktrees.json")) as handle:
+            manifest = json.load(handle)
+        present = {str(k) for k in manifest.get("worktrees", {})}
+        for task_id in ids:
+            self.assertIn(
+                str(task_id),
+                present,
+                f"task {task_id} lost its manifest entry to a racing mount",
+            )
+
+    # --- defect 3: gate fast-track ---
+
+    def test_fresh_branch_does_not_bypass_gates(self):
+        """A branch with no commits beyond main must not fast-track promotion."""
+        _, task_file = self.make_task(
+            "Alpha task for fresh branch gate", criteria=BOXES
+        )
+        self.run_cmd(["move", task_file, "READY"])
+        self.run_cmd(["move", task_file, "PROGRESSING"])
+        task_path = os.path.join(self.store, "progressing", task_file)
+
+        # Deferred imports: pytest's collection hook cannot resolve tasks_ai at
+        # module import time in this fixture.
+        from tasks_ai.context import ProjectContext
+        from tasks_ai.file_manager import FM
+        from tasks_ai.git_service import GitService
+        from tasks_ai.pipeline import PipelineError, PipelineService
+
+        previous = os.getcwd()
+        os.chdir(self.repo_dir)
+        self.addCleanup(lambda: os.chdir(previous))
+        git = GitService(ProjectContext())
+        pipeline = PipelineService(git)
+        task = FM.load(task_path)
+        branch = task.metadata.get("Br")
+        self.assertTrue(
+            git.is_merged(branch, "main"),
+            "a fresh branch is trivially an ancestor of main",
+        )
+        with self.assertRaises(PipelineError) as caught:
+            pipeline.validate_gate(self, task, "DONE", task_path)
+        self.assertEqual(
+            caught.exception.code,
+            "UNFINISHED_CHECKBOXES",
+            "the real gates must run instead of being bypassed",
+        )
+
+    def test_merged_branch_with_work_still_fast_tracks(self):
+        """A branch that did work and was merged must still bypass the gates."""
+        task_id, task_file = self.make_processing_task(
+            "Alpha task for merged branch gate"
+        )
+        task_path = os.path.join(self.store, "progressing", task_file)
+        # The branch is checked out in its worktree, so commit from there; the
+        # main repo stays on main and merges the finished branch.
+        worktree = self.worktree_path(task_id)
+        with open(os.path.join(worktree, "work.txt"), "w") as handle:
+            handle.write("real work\n")
+        for args in (["add", "work.txt"], ["commit", "-m", "real work"]):
+            subprocess.run(
+                ["git"] + args, cwd=worktree, capture_output=True, check=False
+            )
+        # Checkpoint before merging: the sync captures the branch's commits
+        # ahead of main, and after the merge that list is empty by definition.
+        cp = self.run_cmd(["checkpoint", str(task_id)])
+        self.assertTrue(cp["success"], cp)
+        merge = subprocess.run(
+            ["git", "merge", f"{task_file}"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            check=False,
+        )
+        self.assertEqual(merge.returncode, 0, merge.stderr)
+
+        from tasks_ai.context import ProjectContext
+        from tasks_ai.file_manager import FM
+        from tasks_ai.git_service import GitService
+        from tasks_ai.pipeline import PipelineService
+
+        previous = os.getcwd()
+        os.chdir(self.repo_dir)
+        self.addCleanup(lambda: os.chdir(previous))
+        git = GitService(ProjectContext())
+        task = FM.load(task_path)
+        branch = task.metadata.get("Br")
+        self.assertTrue(
+            (task.parts.get("commits") or "").strip(),
+            "the record must show the branch produced commits",
+        )
+        self.assertTrue(git.is_merged(branch, "main"))
+        pipeline = PipelineService(git)
+        self.assertTrue(
+            pipeline.validate_gate(self, FM.load(task_path), "DONE", task_path),
+            "a merged branch that did work keeps its fast-track",
+        )
+
+    # --- defect 4: undo scoping ---
+
+    def test_undo_restores_only_the_target_task(self):
+        """Undo of task 11 must never touch sibling task 1's record."""
+        self.seed_counter(0)
+        id_one, file_one = self.make_task("One task for undo scoping")
+        self.seed_counter(10)
+        id_eleven, file_eleven = self.make_task("Eleven task for undo scoping")
+        self.assertEqual(
+            (id_one, id_eleven),
+            (1, 11),
+            "the sibling-prefix scenario needs ids 1 and 11",
+        )
+        self.run_cmd(["move", file_eleven, "READY"])
+        before_one = self.snapshot_folder(file_one, "backlog")
+        self.assertTrue(before_one, "task 1 must exist in the store")
+
+        res = self.run_cmd(["undo", str(id_eleven)])
+        self.assertTrue(res["success"], res)
+        self.assertTrue(
+            os.path.isdir(os.path.join(self.store, "backlog", file_eleven)),
+            "undo must restore task 11 to its previous state",
+        )
+        self.assertEqual(
+            before_one,
+            self.snapshot_folder(file_one, "backlog"),
+            "undo touched a sibling task with a shorter id prefix",
+        )
+
+    def test_undo_leaves_no_temp_files_in_the_store(self):
+        def temp_entries():
+            return [e for e in os.listdir(self.store) if "tmp" in e.lower()]
+
+        task_id, file = self.make_task("Eleven task for undo temp files")
+        self.run_cmd(["move", file, "READY"])
+        self.assertEqual(temp_entries(), [], "the store must start clean")
+        res = self.run_cmd(["undo", str(task_id)])
+        self.assertTrue(res["success"], res)
+        self.assertEqual(
+            temp_entries(), [], "undo must not create temp dirs inside the shared store"
+        )
