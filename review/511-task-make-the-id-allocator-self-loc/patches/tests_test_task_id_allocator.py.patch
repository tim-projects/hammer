+    def test_allocation_uses_the_store_lock_and_is_reentrant(self):
+        cli = FakeCLI(self.store, self.repo)
+        with patch("tasks_ai.task_id_allocator.store_lock", wraps=store_lock) as locked:
+            self.assertEqual(allocate_task_id(cli), [1])
+        locked.assert_called_once_with(cli)
+
+        with store_lock(cli):
+            self.assertEqual(allocate_task_id(cli), [1])
+
+    def test_guard_never_calls_the_id_allocator(self):
+        engine = GuardEngine(repo_root=self.repo, tasks_path=self.store, cwd=self.repo)
+        with (
+            patch(
+                "tasks_ai.task_id_allocator.allocate_task_id",
+                side_effect=AssertionError("guard must not allocate IDs"),
+            ) as allocator,
+            patch(
+                "tasks_ai.guard_engine.allocate_task_id",
+                side_effect=AssertionError("guard must not allocate IDs"),
+                create=True,
+            ) as imported_allocator,
+        ):
+            engine.scan()
+        allocator.assert_not_called()
+        imported_allocator.assert_not_called()
