+    def test_research_gate_requires_recorded_research(self):
+        """READY -> PROGRESSING is blocked until a research pass is recorded."""
+        res = self.run_cmd(
+            [
+                "create",
+                "Research Gate Task",
+                "--story",
+                "As a user I want research recorded before implementation.",
+                "--tech",
+                "Exit hooks on READY gate the transition to PROGRESSING.",
+                "--criteria",
+                "Gate blocks without research and passes after recording it.",
+                "--plan",
+                "1. Block\n2. Record research\n3. Promote",
+            ]
+        )
+        self.assertTrue(res["success"], res)
+        task_file = res["data"]["file"]
+
+        self.run_cmd(["move", task_file, "READY"])
+
+        res = self.run_cmd(["move", task_file, "PROGRESSING"])
+        self.assertFalse(res["success"], "PROGRESSING must be blocked before research")
+        self.assertIn("RESEARCH_REQUIRED", res["error"])
+
+        # findings arrive as a file (bulk pass) like every other long-form flag
+        research_path = os.path.join(self.test_dir, "research.md")
+        with open(research_path, "w") as f:
+            f.write("Read pipeline_hooks.py exit-hook registration and move_logic.\n")
+            f.write("Online search: no prior art for research gating in this repo.\n")
+        res = self.run_cmd(["modify", task_file, "--research", research_path])
+        self.assertTrue(res["success"], res)
+
+        task = FM.load(os.path.join(self.dev_tasks_dir, "ready", task_file))
+        self.assertTrue(task.metadata.get("Rr"))
+        with open(research_path) as f:
+            self.assertEqual(task.parts["research"], f.read())
+
+        res = self.run_cmd(["move", task_file, "PROGRESSING"])
+        self.assertTrue(res["success"], res)
+
