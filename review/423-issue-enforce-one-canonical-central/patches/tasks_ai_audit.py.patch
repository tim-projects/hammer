+def _patch_base_ref(cli, branch):
+    """Return the stable comparison base for a task branch.
+
+    Repositories without a main or master branch still need review patches.
+    Their task branch root commit is the only stable base that does not move
+    when pipeline branches advance.
+    """
+    main_branch = cli.git.get_default_branch()
+    if main_branch:
+        return main_branch
+    root = (
+        cli.git.run(
+            ["rev-list", "--max-parents=0", branch],
+            cwd=cli.context.main_repo_root,
+        )
+        .stdout.strip()
+        .splitlines()
+    )
+    return root[0] if root else "HEAD"
+
 
 def get_changed_files(cli, task_path, branch):
