+                        file_id_str = f.read().strip()
+                        current = int(file_id_str) if file_id_str.isdigit() else 0
+                except Exception:
+                    current = 0
+
+        current += 1
+        
+        # Atomic write new value
+        cli._atomic_write(self.counter_file, str(current))
