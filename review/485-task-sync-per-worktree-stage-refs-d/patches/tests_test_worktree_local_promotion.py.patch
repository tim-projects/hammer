+    def test_demotion_syncs_task_local_refs_for_each_target(self):
+        branch, worktree = self.create_task(485)
+        service = self.service_for({"485": worktree})
+        task = self.task(485, branch)
+
+        service.promote_task(task, "TESTING")
+        testing_commit = self.commit_on_branch(
+            "485-TESTING", worktree, "testing.txt", "testing\n"
+        )
+        service.promote_task(task, "STAGING")
+        staging_commit = self.commit_on_branch(
+            "485-STAGING", worktree, "staging.txt", "staging\n"
+        )
+        service.promote_task(task, "PR")
+        pr_commit = self.commit_on_branch("485-PR", worktree, "pr.txt", "pr\n")
+        main_commit = git("rev-parse", "main", cwd=self.repo).stdout.strip()
+        git("update-ref", "refs/remotes/origin/main", main_commit, cwd=self.repo)
+
+        cases = (
+            ("TESTING", testing_commit, staging_commit),
+            ("STAGING", staging_commit, pr_commit),
+            ("PR", pr_commit, None),
+            ("PROGRESSING", pr_commit, None),
+        )
+        for target, included, excluded in cases:
+            with self.subTest(target=target):
+                service.demote_task(task, target)
+                self.assertTrue(self.is_ancestor(included, branch))
+                if excluded:
+                    self.assertFalse(self.is_ancestor(excluded, branch))
+                self.assertEqual(self.current_branch(worktree), branch)
+
+                promotion_target = target if target != "PROGRESSING" else "TESTING"
+                service.promote_task(task, promotion_target)
+                self.assertTrue(self.is_ancestor(branch, f"485-{promotion_target}"))
+
+    def test_demotion_conflict_reports_paths_and_leaves_worktree_clean(self):
+        branch, worktree = self.create_task(485)
+        service = self.service_for({"485": worktree})
+        task = self.task(485, branch)
+        service.promote_task(task, "TESTING")
+
+        self.commit_on_branch(branch, worktree, "README.md", "task version\n")
+        self.commit_on_branch("485-TESTING", worktree, "README.md", "stage version\n")
+        git("checkout", branch, cwd=worktree)
+
+        with self.assertRaises(PipelineMergeConflict) as raised:
+            service.demote_task(task, "TESTING")
+
+        self.assertEqual(raised.exception.paths, ["README.md"])
+        self.assertEqual(git("status", "--porcelain", cwd=worktree).stdout.strip(), "")
+        merge_head = git(
+            "rev-parse", "--verify", "MERGE_HEAD", cwd=worktree, check=False
+        )
+        self.assertNotEqual(0, merge_head.returncode)
+        unmerged = git("ls-files", "--unmerged", cwd=worktree)
+        self.assertEqual(unmerged.stdout.strip(), "")
+
