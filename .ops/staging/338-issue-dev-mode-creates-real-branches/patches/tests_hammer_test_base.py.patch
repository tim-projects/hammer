+def project_tasks_ai():
+    """Import tasks_ai from THIS project.
+
+    tests/ carries a stale tasks_ai copy, and pytest puts tests/ ahead of the
+    project root on sys.path, so a plain `import tasks_ai` can resolve the stale
+    package. Load the project's package explicitly, replacing any stale copy
+    already in sys.modules.
+    """
+    import importlib
+    import importlib.util
+    import sys
+
+    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    package_dir = os.path.join(root, "tasks_ai")
+    for name in [n for n in sys.modules if n == "tasks_ai" or n.startswith("tasks_ai.")]:
+        module = sys.modules[name]
+        paths = list(getattr(module, "__path__", [])) or [getattr(module, "__file__", "")]
+        if paths and os.path.dirname(str(paths[0])) != root:
+            del sys.modules[name]
+    spec = importlib.util.spec_from_file_location(
+        "tasks_ai",
+        os.path.join(package_dir, "__init__.py"),
+        submodule_search_locations=[package_dir],
+    )
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["tasks_ai"] = module
+    spec.loader.exec_module(module)
+    return module
+
+
