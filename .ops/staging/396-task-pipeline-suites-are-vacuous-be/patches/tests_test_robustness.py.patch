+    def enter_progressing(self, file):
+        """Record a research pass, then start work.
+
+        The READY exit gate demands recorded research (Rr + findings) before
+        PROGRESSING; an unchecked move leaves the task stuck in READY and
+        makes every downstream gate assertion vacuous.
+        """
+        findings = (
+            "Read pipeline_hooks.py exit-hook registration, move_logic and the "
+            "tests covering this flow."
+        )
+        res = self.run_cmd(["modify", file, "--research", findings])
+        self.assertTrue(res["success"], f"research record failed for {file}: {res}")
+        res = self.run_cmd(["move", file, "PROGRESSING"])
+        self.assertTrue(res["success"], f"move to PROGRESSING failed for {file}: {res}")
+
+    def complete_review_gate(self, file):
+        """Run the full, now-mandatory review workflow.
+
+        STAGING needs Rc, and Rc is only granted when the patches were
+        audited, a proof bound to the audit hash, and a per-patch review
+        recorded with matching md5s.
+        """
+        res = self.run_cmd(["audit", file])
+        self.assertTrue(res["success"], f"audit failed for {file}: {res}")
+        res = self.run_cmd(
+            ["verify", file, "--proof", "Reviewed patches and criteria pass."]
+        )
+        self.assertTrue(res["success"], f"verify failed for {file}: {res}")
+        res = self.run_cmd(["modify", file, "--reviewed"])
+        self.assertTrue(res["success"], f"--reviewed failed for {file}: {res}")
+        res = self.run_cmd(["modify", file, "--regression-check"])
+        self.assertTrue(res["success"], f"--regression-check failed for {file}: {res}")
+
