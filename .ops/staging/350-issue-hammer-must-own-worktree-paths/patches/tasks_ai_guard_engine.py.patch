+    # --- worktree ownership ---
+    def _main_repo_root(self):
+        """Main checkout root, resolved from the common git dir (worktree-safe)."""
+        result = run_git(["rev-parse", "--git-common-dir"], cwd=self.cwd)
+        if result.returncode != 0 or not result.stdout.strip():
+            return None
+        common = result.stdout.strip()
+        if not os.path.isabs(common):
+            common = os.path.join(os.path.abspath(self.cwd), common)
+        common = os.path.normpath(common)
+        return os.path.dirname(common) if os.path.basename(common) == ".git" else common
+
+    def _worktrees_base(self):
+        """<main checkout>/.task-worktrees - where hammer mounts task worktrees."""
+        main = self._main_repo_root()
+        return os.path.join(main, ".task-worktrees") if main else None
+
