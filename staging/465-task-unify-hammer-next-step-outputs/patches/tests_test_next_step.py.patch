@@ -0,0 +1,76 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tasks_ai.cli_io import error, next_step
+
+
+def _cli(**kwargs):
+    defaults = {"as_json": False, "quiet": False, "output_messages": []}
+    defaults.update(kwargs)
+    return SimpleNamespace(**defaults)
+
+
+def test_next_step_json_schema_and_exit_status(capsys):
+    with pytest.raises(SystemExit) as exc:
+        next_step(
+            _cli(as_json=True),
+            "Complete verification proof for task 419.",
+            hint="Run the required review.",
+        )
+
+    response = json.loads(capsys.readouterr().out)
+    assert exc.value.code == 1
+    assert response == {
+        "success": False,
+        "status": "next_step",
+        "next_step": "Complete verification proof for task 419.",
+        "messages": [],
+        "hint": "Run the required review.",
+    }
+    assert "error" not in response
+    assert "error_code" not in response
+
+
+def test_next_step_terminal_wording(capsys):
+    with pytest.raises(SystemExit) as exc:
+        next_step(
+            _cli(),
+            "Complete verification proof for task 419.",
+            hint="WHAT: Review every patch.",
+        )
+
+    output = capsys.readouterr().out
+    assert exc.value.code == 1
+    assert output.startswith("NEXT STEP:")
+    assert "WHAT: Review every patch." in output
+    assert "Error:" not in output
+
+
+def test_genuine_error_remains_a_normal_error(capsys):
+    with pytest.raises(SystemExit) as exc:
+        error(
+            _cli(as_json=True),
+            "Integrity mismatch.",
+            error_code="INTEGRITY_MISMATCH",
+        )
+
+    response = json.loads(capsys.readouterr().out)
+    assert exc.value.code == 1
+    assert response == {
+        "success": False,
+        "error_code": "INTEGRITY_MISMATCH",
+        "error": "Integrity mismatch.",
+        "messages": [],
+    }
+    assert "status" not in response
+
+
+def test_genuine_error_always_has_a_non_empty_code(capsys):
+    with pytest.raises(SystemExit):
+        error(_cli(as_json=True), "Unexpected failure.", error_code="")
+
+    response = json.loads(capsys.readouterr().out)
+    assert response["error_code"] == "UNEXPECTED_ERROR"
+    assert response["error"] == "Unexpected failure."
