+class TestCloneRobustness(unittest.TestCase):
+    """`clone_local` absorbs a transient local-clone failure and never leaves debris."""
+
+    def setUp(self):
+        self.source = tempfile.mkdtemp(prefix="clone_src_")
+        self.addCleanup(shutil.rmtree, self.source, True)
+        subprocess.run(["git", "init", "--quiet", self.source], check=True)
+        with open(os.path.join(self.source, "f"), "w") as f:
+            f.write("x")
+        subprocess.run(["git", "-C", self.source, "add", "."], check=True)
+        subprocess.run(
+            ["git", "-C", self.source, "commit", "-qm", "init"],
+            check=True,
+            env={
+                **os.environ,
+                "GIT_AUTHOR_NAME": "t",
+                "GIT_AUTHOR_EMAIL": "t@t",
+                "GIT_COMMITTER_NAME": "t",
+                "GIT_COMMITTER_EMAIL": "t@t",
+            },
+        )
+        self.dest = tempfile.mkdtemp(prefix="clone_dst_")
+        shutil.rmtree(self.dest)
+
+    def test_retries_a_transient_failure(self):
+        real_run = context_module.subprocess.run
+        calls = []
+
+        def flaky(cmd, *a, **k):
+            if cmd[:2] == ["git", "clone"]:
+                calls.append(cmd)
+                if len(calls) == 1:
+                    return subprocess.CompletedProcess(
+                        cmd, 1, "", "failed to copy file"
+                    )
+            return real_run(cmd, *a, **k)
+
+        with patch.object(context_module.subprocess, "run", flaky):
+            result = clone_local(self.source, self.dest)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertTrue(os.path.isdir(os.path.join(self.dest, ".git")))
+        self.assertEqual(len(calls), 2)
+
+    def test_failed_clone_leaves_no_debris(self):
+        real_run = context_module.subprocess.run
+
+        def always_fails(cmd, *a, **k):
+            if cmd[:2] == ["git", "clone"]:
+                return subprocess.CompletedProcess(cmd, 1, "", "failed to copy file")
+            return real_run(cmd, *a, **k)
+
+        with patch.object(context_module.subprocess, "run", always_fails):
+            result = clone_local(self.source, self.dest)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertFalse(os.path.exists(self.dest), "no half-written dest")
+        leftovers = glob.glob(self.dest + ".tmp-*")
+        self.assertEqual(leftovers, [], "no tmp clone left behind")
