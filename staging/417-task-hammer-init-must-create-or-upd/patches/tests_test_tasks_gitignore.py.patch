+++ b/tests/test_tasks_gitignore.py
@@ -0,0 +1,197 @@
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+STORE_CONFIG = {
+    "repo": {
+        "lint": "noop",
+        "test": "noop",
+        "type_check": "noop",
+        "format": "noop",
+        "skip_push": True,
+    }
+}
+
+
+class TestTasksGitignore(unittest.TestCase):
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp(prefix="hammer_gitignore_")
+        self.repo_dir = os.path.join(self.test_dir, "repo")
+        os.makedirs(self.repo_dir)
+        self.git("init")
+        self.git("config", "user.email", "test@example.com")
+        self.git("config", "user.name", "Test User")
+        with open(os.path.join(self.repo_dir, "README.md"), "w") as handle:
+            handle.write("# Test Repo\n")
+        self.git("add", "README.md")
+        self.git("commit", "-m", "Initial commit")
+
+        project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+        self.script_path = os.path.join(self.repo_dir, "hammer")
+        os.symlink(os.path.join(project_root, "hammer"), self.script_path)
+        self.git("add", "hammer")
+        self.git("commit", "-m", "Add hammer")
+        self.seed_tasks_branch()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def git(self, *args, cwd=None, check=True):
+        return subprocess.run(
+            ["git", *args],
+            cwd=cwd or self.repo_dir,
+            capture_output=True,
+            text=True,
+            check=check,
+        )
+
+    def seed_tasks_branch(self, gitignore=None):
+        index = os.path.join(self.test_dir, "seed_index")
+        config_path = os.path.join(self.test_dir, "seed_config.yaml")
+        with open(config_path, "w") as handle:
+            json.dump(STORE_CONFIG, handle)
+        env = dict(os.environ, GIT_INDEX_FILE=index)
+
+        def seed_git(*args):
+            return subprocess.run(
+                ["git", *args],
+                cwd=self.repo_dir,
+                capture_output=True,
+                text=True,
+                check=True,
+                env=env,
+            ).stdout.strip()
+
+        blob = seed_git("hash-object", "-w", config_path)
+        seed_git("update-index", "--add", "--cacheinfo", f"100644,{blob},config.yaml")
+        if gitignore is not None:
+            gitignore_path = os.path.join(self.test_dir, "seed_gitignore")
+            with open(gitignore_path, "w") as handle:
+                handle.write(gitignore)
+            blob = seed_git("hash-object", "-w", gitignore_path)
+            seed_git(
+                "update-index", "--add", "--cacheinfo", f"100644,{blob},.gitignore"
+            )
+        tree = seed_git("write-tree")
+        commit = subprocess.run(
+            ["git", "commit-tree", tree, "-m", "Seed tasks store"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            text=True,
+            check=True,
+        ).stdout.strip()
+        subprocess.run(
+            ["git", "branch", "-f", "tasks", commit],
+            cwd=self.repo_dir,
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+
+    def run_init(self):
+        result = subprocess.run(
+            [self.script_path, "tasks", "-j", "init"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        payload = json.loads(result.stdout)
+        self.assertTrue(payload["success"], payload)
+        return payload
+
+    @property
+    def store(self):
+        return os.path.join(self.repo_dir, ".tasks")
+
+    @property
+    def gitignore_path(self):
+        return os.path.join(self.store, ".gitignore")
+
+    def read_gitignore(self):
+        with open(self.gitignore_path) as handle:
+            return handle.read()
+
+    def test_init_creates_template_and_tracks_markdown(self):
+        self.run_init()
+
+        content = self.read_gitignore()
+        self.assertIn("!*.md", content)
+        self.assertNotIn("\n*.md\n", content)
+        self.assertIn("/.hammer-lock", content)
+        self.assertNotIn(".hammer tasks/", content)
+
+        markdown = os.path.join(self.store, "backlog", "1-test-task", "story.md")
+        os.makedirs(os.path.dirname(markdown))
+        with open(markdown, "w") as handle:
+            handle.write("# Task\n")
+        ignored = self.git(
+            "check-ignore",
+            "--no-index",
+            "backlog/1-test-task/story.md",
+            cwd=self.store,
+            check=False,
+        )
+        self.assertNotEqual(ignored.returncode, 0, ignored.stdout)
+
+    def test_init_updates_stale_rules_and_preserves_user_entries(self):
+        self.seed_tasks_branch(
+            "*.md\n!README.md\n.hammer tasks/\n*.bak\n# User-authored entries\ncustom/\n"
+        )
+
+        self.run_init()
+
+        content = self.read_gitignore()
+        self.assertIn("!*.md", content)
+        self.assertNotIn("\n*.md\n", content)
+        self.assertNotIn("!README.md", content)
+        self.assertNotIn(".hammer tasks/", content)
+        self.assertIn("custom/", content)
+        self.assertEqual(content.count("!*.md"), 1)
+        self.assertEqual(content.count("*.bak"), 1)
+
+    def test_repeated_init_updates_template_without_resetting_store(self):
+        self.run_init()
+        with open(self.gitignore_path, "w") as handle:
+            handle.write("*.md\ncustom/\n")
+
+        result = subprocess.run(
+            [self.script_path, "tasks", "-j", "init"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        payload = json.loads(result.stdout)
+        self.assertFalse(payload["success"])
+        self.assertIn("already initialized", payload["error"])
+
+        content = self.read_gitignore()
+        self.assertIn("!*.md", content)
+        self.assertNotIn("\n*.md\n", content)
+        self.assertIn("custom/", content)
+        self.assertEqual(content.count("!*.md"), 1)
+
+    def test_repeated_init_is_idempotent(self):
+        self.run_init()
+        first = self.read_gitignore()
+
+        result = subprocess.run(
+            [self.script_path, "tasks", "-j", "init"],
+            cwd=self.repo_dir,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        self.assertFalse(json.loads(result.stdout)["success"])
+        second = self.read_gitignore()
+
+        self.assertEqual(first, second)
+        self.assertEqual(second.count("!*.md"), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
