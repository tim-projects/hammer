#!/usr/bin/env python3
"""
HAMMER - Main wrapper for all tools
Usage: hammer <tool> <command> [args]
   or: hammer <command> [args] (auto-detects tool)

Tools:
  tasks <command>     - Task management (list, create, move, etc.)
  check <command>     - Quality checks (lint, test, all, etc.)
  repo <command>      - Repo management (merge, sync, etc.)
  guard <command>     - Task ID integrity enforcement (scan, check, rebuild)

Examples:
  hammer tasks list
  hammer tasks move 42 PROGRESSING
  hammer check all
  hammer check lint --fix
  hammer repo sync
  # Auto-detected examples:
  hammer list
  hammer move 42 PROGRESSING
  hammer all
  hammer lint --fix
  hammer audit 42
  hammer verify 42 --proof "tests green"

IMPORTANT: Always use -j for JSON output (machine-parseable for agents).
For help on any command, use hammer <tool> <command> -h
"""

import json
import sys
import subprocess
import os
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent

TOOLS = {
    "tasks": SCRIPT_DIR / "tasks.py",
    "check": SCRIPT_DIR / "tasks_ai" / "check_wrapper.py",
    "repo": SCRIPT_DIR / "repo.py",
    "guard": SCRIPT_DIR / "guard.py",
}

# Mapping of all known commands to their owning tool
# Ensures comprehensive coverage for auto-detection
COMMAND_TO_TOOL = {
    # tasks commands
    "init": "tasks",
    "save": "tasks",
    "list": "tasks",
    "current": "tasks",
    "show": "tasks",
    "checkpoint": "tasks",
    "review": "tasks",
    "link": "tasks",
    "unlink": "tasks",
    "create": "tasks",
    "modify": "tasks",
    "move": "tasks",
    "delete": "tasks",
    "mount": "tasks",
    "reconcile": "tasks",
    "cleanup": "tasks",
    "config": "tasks",
    "upgrade": "tasks",
    "undo": "tasks",
    "doctor": "tasks",
    "audit": "tasks",
    "verify": "tasks",
    "restore": "tasks",
    "unarchive": "tasks",
    "init-hooks": "tasks",
    # check commands
    "lint": "check",
    "test": "check",
    "typecheck": "check",
    "format": "check",
    "all": "check",
    # repo commands
    "merge": "repo",
    "sync": "repo",
    "commit": "repo",
    "git": "repo",
    "status": "repo",
    "check-merged": "repo",
    "check-merged-testing": "repo",
    "branch": "repo",
    # guard commands
    "scan": "guard",
    "refresh": "guard",
    "rebuild": "guard",
    "hooks": "guard",
}

def error(msg):
    print(f"❌ HAMMER SAY NO! {msg} 🔨", file=sys.stderr)
    sys.exit(1)

def _json_error(msg):
    print(json.dumps({"success": False, "error_code": "UNKNOWN_COMMAND", "error": msg}))
    sys.exit(1)


def _normalize_args(argv):
    """Treat -j/--json as a wrapper-level directive and keep tool argv intact."""
    args = list(argv)
    json_requested = any(arg in ("-j", "--json") for arg in args)
    help_requested = any(arg in ("-h", "--help") for arg in args)
    if json_requested:
        args = [arg for arg in args if arg not in ("-j", "--json")]
    return args, json_requested and not help_requested


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    args, json_requested = _normalize_args(sys.argv[1:])
    if not args:
        if json_requested:
            _json_error("No command provided.")
        print(__doc__)
        sys.exit(1)

    first_arg = args[0]

    # Handle help flags
    if first_arg in ('-h', '--help', 'help'):
        # Show hammer help
        print(__doc__)
        sys.exit(0)

    # Alias: 'hammer show tasks' => 'hammer tasks list'
    if first_arg == "show" and len(args) >= 3 and args[1] == "tasks":
        # Rewrite to: hammer tasks list
        tool = "tasks"
        tool_args = ["list"]
    # Check if first arg is an explicit tool
    elif first_arg in TOOLS:
        tool = first_arg
        tool_args = args[1:]
    # Check if first arg is a known command (auto-detect tool)
    elif first_arg in COMMAND_TO_TOOL:
        tool = COMMAND_TO_TOOL[first_arg]
        tool_args = args  # Keep all original args (including the command)
    else:
        message = (
            f"Unknown tool or command: '{first_arg}'. "
            f"Valid tools: {', '.join(TOOLS.keys())}. "
            f"Known commands: {', '.join(sorted(COMMAND_TO_TOOL.keys()))}"
        )
        if json_requested:
            _json_error(message)
        error(message)

    # A bare tool invocation delegates to the tool, which prints its own usage
    # and exits 1 (same rule for every tool).
    tool_path = TOOLS[tool]
    cmd = [sys.executable, str(tool_path)]
    if json_requested:
        cmd.append("--json")
    cmd.extend(tool_args)
    if json_requested:
        result = subprocess.run(cmd, capture_output=True, text=True)
        output = result.stdout.strip()
        try:
            parsed = json.loads(output) if output else None
        except json.JSONDecodeError:
            parsed = None
        if parsed is None:
            payload = {
                "success": result.returncode == 0 and (tool != "tasks" or bool(output)),
                "output": output,
            }
            if result.stderr.strip():
                payload["error"] = result.stderr.strip()
            print(json.dumps(payload))
        else:
            print(output)
        sys.exit(result.returncode)
    result = subprocess.run(cmd)
    sys.exit(result.returncode)

if __name__ == "__main__":
    main()