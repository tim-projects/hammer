+"""check must run the configured tools from a task worktree, not abort.
+
+Locked down here:
+
+1. Root: a worktree's .git *file* counts as a project root, so check resolves
+   the worktree itself instead of the main repo.
+2. Config: the store config (repo.lint/test/type_check/format) is found from a
+   worktree even though only the main repo carries .tasks.
+3. Paths: a configured tool may be a command path (e.g. /bin/true or a custom
+   script path), not just a tool name.
+4. Loudness: 'check all' is never silently skipped by the
+   .last_validation_hash short-circuit, in a worktree or on main.
+"""
+
+import ast
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+STORE_CONFIG = """repo:
+  lint: /bin/true
+  test: /bin/true
+  type_check: /bin/true
+  format: /bin/true
+"""
+
+
+def parse_results(stdout):
+    """Pull the Validator result list out of the check_wrapper output."""
+    match = re.search(r"Results: (\[.*\])", stdout)
+    assert match, f"no Results line in wrapper output: {stdout}"
+    return ast.literal_eval(match.group(1))
+
+
+class TestCheckFromWorktree(unittest.TestCase):
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+        self.main_dir = os.path.join(self.test_dir, "main")
+        os.makedirs(self.main_dir)
+        self.git("init")
+        shutil.copy(os.path.join(PROJECT_ROOT, "check.py"), self.main_dir)
+        # The symlinked hammer resolves to the working tree under test, so these
+        # tests exercise the branch code, not a clone of main.
+        os.symlink(
+            os.path.join(PROJECT_ROOT, "hammer"), os.path.join(self.main_dir, "hammer")
+        )
+        with open(os.path.join(self.main_dir, ".gitignore"), "w") as handle:
+            handle.write(".tasks/\n")
+        os.makedirs(os.path.join(self.main_dir, ".tasks"))
+        with open(os.path.join(self.main_dir, ".tasks", "config.yaml"), "w") as handle:
+            handle.write(STORE_CONFIG)
+        with open(os.path.join(self.main_dir, "README.md"), "w") as handle:
+            handle.write("# Test Repo\n")
+        self.git("add", "-A")
+        self.git("commit", "-m", "Initial commit")
+        self.wt = os.path.join(self.test_dir, "wt")
+        self.git("worktree", "add", self.wt)
+
+    def tearDown(self):
+        self.git("worktree", "remove", "--force", self.wt)
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    # --- helpers ---
+
+    def git(self, *args):
+        return subprocess.run(
+            ["git", "-c", "user.email=t@t.io", "-c", "user.name=t", *args],
+            cwd=self.main_dir,
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+
+    def run_check(self, *args, cwd):
+        result = subprocess.run(  # noqa: PLW1510
+            [sys.executable, "check.py", *args],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+        )
+        return result.returncode, result.stdout + result.stderr
+
+    def run_hammer_check(self, cwd, env=None):
+        result = subprocess.run(  # noqa: PLW1510
+            [os.path.join(self.wt, "hammer"), "check", "all"],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            env=env,
+        )
+        return result.returncode, result.stdout + result.stderr, parse_results(result.stdout)
+
+    # --- tests ---
+
+    def test_worktree_git_file_is_a_project_root(self):
+        probe = subprocess.run(  # noqa: PLW1510
+            [sys.executable, "-c", "import check; print(check.find_project_root())"],
+            cwd=self.wt,
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(probe.returncode, 0, probe.stderr)
+        self.assertEqual(
+            os.path.realpath(probe.stdout.strip()),
+            os.path.realpath(self.wt),
+            "a worktree's .git file must resolve to the worktree, not the main repo",
+        )
+
+    def test_check_all_runs_tools_from_worktree(self):
+        code, out = self.run_check("all", cwd=self.wt)
+        self.assertEqual(code, 0, out)
+        self.assertIn("Running /bin/true (lint)", out)
+        self.assertNotIn("not configured", out)
+        self.assertNotIn("skipping validation", out)
+
+    def test_hammer_check_all_from_worktree(self):
+        subdir = os.path.join(self.wt, "nested")
+        os.makedirs(subdir)
+        for cwd in (self.wt, subdir):
+            # even from a subdirectory the tools must run against the worktree root
+            _code, out, results = self.run_hammer_check(cwd)
+            self.assertNotIn("not configured", out)
+            self.assertEqual(
+                [r["tool"] for r in results], ["lint", "test", "typecheck", "format"]
+            )
+            self.assertTrue(all(r["success"] for r in results), out)
+
+    def test_configured_tool_may_be_a_command_path(self):
+        fake_bin = os.path.join(self.test_dir, "bin")
+        os.makedirs(fake_bin)
+        fake_ruff = os.path.join(fake_bin, "ruff")
+        with open(fake_ruff, "w") as handle:
+            handle.write("#!/bin/sh\necho RUFF-PATH-RAN\n")
+        os.chmod(fake_ruff, 0o755)
+        with open(os.path.join(self.main_dir, ".tasks", "config.yaml"), "w") as handle:
+            handle.write(STORE_CONFIG.replace("lint: /bin/true", f"lint: {fake_ruff}"))
+
+        env = dict(os.environ, PATH=f"{fake_bin}{os.pathsep}{os.environ['PATH']}")
+        _code, _out, results = self.run_hammer_check(self.wt, env=env)
+
+        lint = next(r for r in results if r["tool"] == "lint")
+        self.assertTrue(lint["success"], lint)
+        self.assertIn("RUFF-PATH-RAN", lint["stdout"])
+
+    def test_check_all_is_not_silently_skipped_when_unchanged(self):
+        head = self.git("rev-parse", "HEAD").stdout.strip()
+        with open(os.path.join(self.main_dir, ".tasks", ".last_validation_hash"), "w") as h:
+            h.write(head + "\n")
+
+        code, out = self.run_check("all", cwd=self.wt)
+        self.assertEqual(code, 0, out)
+        self.assertNotIn("skipping validation", out)
+        self.assertIn("Running /bin/true (lint)", out)
+
+        # The wrapper drives Validator.run_all: a stale hash must not collapse
+        # it into the single 'all' skip entry either.
+        _code, out, results = self.run_hammer_check(self.wt)
+        self.assertNotIn("skipping validation", out)
+        self.assertEqual(len(results), 4, out)
+
+    def test_check_all_still_runs_on_main(self):
+        code, out = self.run_check("all", cwd=self.main_dir)
+        self.assertEqual(code, 0, out)
+        self.assertIn("Running /bin/true (lint)", out)
+        self.assertNotIn("not configured", out)
