+    def test_conflicting_promotion_halts_with_merge_conflict(self):
+        """A promotion whose merge conflicts halts with MERGE_CONFLICT, cleanly.
+
+        Regression for the Promotion merge conflict halts with traceback issue:
+        the failed promotion merge must abort (no in-progress merge left behind)
+        and surface the MERGE_CONFLICT error code, never a Python traceback.
+        """
+        res = self.run_cmd(
+            [
+                "create",
+                "Conflicting Promotion",
+                "--story",
+                "As a user I want a conflicted promotion to halt predictably.",
+                "--tech",
+                "Git merge orchestration in the pipeline promotion path.",
+                "--criteria",
+                "Promotion halts with MERGE_CONFLICT and leaves the repo clean.",
+                "--plan",
+                "1. Create task\n2. Conflicting change\n3. Promote\n4. Assert clean halt",
+            ]
+        )
+        self.assertTrue(res["success"], res)
+        task_file = res["data"]["file"]
+        task_id = res["data"]["id"]
+
+        self.run_cmd(["move", task_file, "READY"])
+        self.enter_progressing(task_file)
+
+        worktree_path = self.get_worktree_path(task_id)
+        wt = (
+            worktree_path
+            if worktree_path and os.path.exists(worktree_path)
+            else self.repo_dir
+        )
+
+        # Task branch edits the first line of README.md one way.
+        subprocess.run(["git", "checkout", task_file], cwd=wt, capture_output=True)  # noqa: PLW1510
+        readme = os.path.join(wt, "README.md")
+        with open(readme) as f:
+            lines = f.readlines()
+        lines[0] = "# Task version\n"
+        with open(readme, "w") as f:
+            f.writelines(lines)
+        subprocess.run(["git", "add", "README.md"], cwd=wt, capture_output=True)  # noqa: PLW1510
+        subprocess.run(
+            ["git", "commit", "-m", "Task change"], cwd=wt, capture_output=True
+        )  # noqa: PLW1510
+
+        # The pipeline branch already carries a conflicting edit of that line.
+        self.git_checkout_main()
+        subprocess.run(  # noqa: PLW1510
+            ["git", "checkout", "-b", "testing"],
+            cwd=self.dev_repo_dir,
+            capture_output=True,
+        )
+        with open(os.path.join(self.dev_repo_dir, "README.md")) as f:
+            lines = f.readlines()
+        lines[0] = "# Pipeline version\n"
+        with open(os.path.join(self.dev_repo_dir, "README.md"), "w") as f:
+            f.writelines(lines)
+        subprocess.run(
+            ["git", "add", "README.md"], cwd=self.dev_repo_dir, capture_output=True
+        )  # noqa: PLW1510
+        subprocess.run(
+            ["git", "commit", "-m", "Pipeline change"],
+            cwd=self.dev_repo_dir,
+            capture_output=True,
+        )  # noqa: PLW1510
+        self.git_checkout_main()
+
+        self.complete_current_criteria(task_file)
+        res = self.run_cmd(["move", task_file, "TESTING"])
+
+        self.assertFalse(res["success"], f"Conflicting promotion should fail: {res}")
+        self.assertNotIn("JSON Decode Error", res.get("error", ""))
+        self.assertNotIn("Traceback", json.dumps(res))
+        self.assertIn("Merge conflict", res.get("error", ""))
+        for section in ("WHAT:", "WHY:", "HOW:", "CONSEQUENCE:"):
+            self.assertIn(section, res["hint"], f"hint missing {section}")
+
+        # No in-progress merge may survive in the repo the CLI acts on.
+        merge_head = subprocess.run(  # noqa: PLW1510
+            ["git", "rev-parse", "--verify", "MERGE_HEAD"],
+            cwd=self.dev_repo_dir,
+            capture_output=True,
+            text=True,
+        )
+        self.assertNotEqual(0, merge_head.returncode, "merge left in progress")
+        unmerged = subprocess.run(  # noqa: PLW1510
+            ["git", "ls-files", "--unmerged"],
+            cwd=self.dev_repo_dir,
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual("", unmerged.stdout.strip(), "conflict markers left behind")
+
+        # The task stays in PROGRESSING, so the move can be retried after resolving.
+        self.assertTrue(
+            os.path.exists(os.path.join(self.dev_tasks_dir, "progressing", task_file)),
+            "task should remain in progressing",
+        )
+
